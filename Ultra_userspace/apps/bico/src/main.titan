# espera: BIEN
# BICO en TITAN++ (corte 4e de INTI, 1d de docs/plan/EL_FOCO.md, 10-10): lee
# datos/foto.bmp y datos/foto.qoi y deja al lado datos/fotob.bic y
# datos/fotoq.bic, el formato que el escritorio ya sabe pintar (los iconos del
# DIRECTOR). El port de `bico.inti`, con los mismos bytes de salida. Por
# consola, una linea por formato con su codigo:
#
#     0  bien               5  medidas: cero, o mas de 256 de lado
#     1  no se leyo entero  6  cortado: faltan bytes que la cabecera promete
#        (no esta, vacio,   7  no se pudo crear la salida
#        mas de 256 KiB)    8  no se pudo guardar
#     3  no es ese formato
#     4  variante que no se soporta (BMP comprimido, 16 bits...)
#
# ** POR QUE NO SE DESBORDA, que es lo que hacia a `bico.inti` de sistema (D3
# de PLAN_INTI_SAMURAI): toda medida que viene del fichero se compara con lo
# que hay ANTES de usarla; un byte fuera de lo leido es -1, no memoria de
# otro; y una suma que se pasara de 64 bits es un NO al correr (T0060), no
# una vuelta. Las de QOI que DAN la vuelta a proposito (`r + dr` modulo 256)
# se escriben con `% 256`, a la vista.
#
# ** Y un fichero ROTO no deja salida: los pixeles se cuentan ENTEROS en una
# lista, y solo despues se crea el fichero.
mod main "BICO: de BMP o QOI a BICO; un fichero roto da su codigo y ninguna salida"
use director

fn lado_maximo() -> int
    return 256

# La division entera, exacta: TITAN++ no deja una que no lo sea (T0062).
fn div(a: int, d: int) -> int
    return (a - a % d) / d

fn le16(i: int) -> int
    return director.byte(i) + director.byte(i + 1) * 256

fn le32(i: int) -> int
    return le16(i) + le16(i + 2) * 65536

# QOI es BIG-ENDIAN en sus medidas; BMP, little-endian.
fn be32(i: int) -> int
    return director.byte(i) * 16777216 + director.byte(i + 1) * 65536 + director.byte(i + 2) * 256 + director.byte(i + 3)

# ===================================================================
#  BMP: 24 o 32 bits, sin comprimir, de abajo arriba o de arriba abajo
# ===================================================================
#
# El alfa de un BMP de 32 bits SIN COMPRIMIR no es alfa: el formato lo llama
# reservado, y muchos programas lo dejan a cero. Sale opaco.
fn bmp_a_bico(mut px: [int], mut medidas: [int; 2]) -> int
    # Empieza VACIA y sin medida: lo de antes no es de esta imagen.
    px = []
    medidas[0] = 0
    medidas[1] = 0
    let n = director.medida()
    if n < 54
        return 6
    if director.byte(0) != 66 or director.byte(1) != 77
        return 3
    let datos = le32(10)
    if le32(14) < 40
        return 4
    let ancho = le32(18)
    let alto_crudo = le32(22)
    if le16(26) != 1
        return 4
    let bits = le16(28)
    if bits != 24 and bits != 32
        return 4
    if le32(30) != 0
        return 4
    # Un ancho negativo leido sin signo es >= 2^31, y cae aqui igual.
    if ancho == 0 or ancho > lado_maximo()
        return 5
    let mut alto = alto_crudo
    let mut de_arriba = false
    if alto_crudo >= 2147483648
        alto = 4294967296 - alto_crudo
        de_arriba = true
    if alto == 0 or alto > lado_maximo()
        return 5
    let por_pixel = div(bits, 8)
    let fila = div(bits * ancho + 31, 32) * 4
    # *** LA COMPROBACION QUE LIBPNG NO HIZO: lo que la cabecera promete cabe
    # en lo que llego.
    if datos > n
        return 6
    if fila * alto > n - datos
        return 6
    for f in range(alto)
        let mut fuente = alto - 1 - f
        if de_arriba
            fuente = f
        for c in range(ancho)
            let p = datos + fuente * fila + c * por_pixel
            # Un pixel, en el orden de BICO: azul, verde, rojo, alfa (opaco).
            push(mut px, director.byte(p))
            push(mut px, director.byte(p + 1))
            push(mut px, director.byte(p + 2))
            push(mut px, 255)
    medidas[0] = ancho
    medidas[1] = alto
    return 0

# ===================================================================
#  QOI: seis operaciones; el estado es el color anterior y una tabla de 64
# ===================================================================
#
#     11111110 r g b      RGB             00iiiiii            INDEX
#     11111111 r g b a    RGBA            01rrggbb            DIFF (-2..+1)
#     10gggggg rrrrbbbb   LUMA            11nnnnnn            RUN (n+1 veces)
fn qoi_a_bico(mut px: [int], mut medidas: [int; 2]) -> int
    # Empieza VACIA y sin medida: lo de antes no es de esta imagen.
    px = []
    medidas[0] = 0
    medidas[1] = 0
    let n = director.medida()
    if n < 22
        return 6
    if director.byte(0) != 113 or director.byte(1) != 111 or director.byte(2) != 105 or director.byte(3) != 102
        return 3
    let ancho = be32(4)
    let alto = be32(8)
    if ancho == 0 or ancho > lado_maximo() or alto == 0 or alto > lado_maximo()
        return 5
    let canales = director.byte(12)
    if canales != 3 and canales != 4
        return 4
    if director.byte(13) > 1
        return 4
    let mut tabla: [int; 256] = [0; 256]
    let total = ancho * alto
    # Los ocho ultimos bytes son la marca de fin, y no son datos.
    let fin = n - 8
    let mut rojo = 0
    let mut verde = 0
    let mut azul = 0
    let mut alfa = 255
    let mut tanda = 0
    let mut i = 14
    for k in range(total)
        if tanda > 0
            tanda = tanda - 1
        else
            # ** Cada byte que se va a leer se compara con `fin` ANTES.
            if i >= fin
                return 6
            let b1 = director.byte(i)
            if b1 == 254
                if i + 3 >= fin
                    return 6
                rojo = director.byte(i + 1)
                verde = director.byte(i + 2)
                azul = director.byte(i + 3)
                i = i + 4
            else if b1 == 255
                if i + 4 >= fin
                    return 6
                rojo = director.byte(i + 1)
                verde = director.byte(i + 2)
                azul = director.byte(i + 3)
                alfa = director.byte(i + 4)
                i = i + 5
            else
                let tipo = div(b1, 64)
                if tipo == 0
                    let sitio = (b1 % 64) * 4
                    rojo = tabla[sitio]
                    verde = tabla[sitio + 1]
                    azul = tabla[sitio + 2]
                    alfa = tabla[sitio + 3]
                    i = i + 1
                else if tipo == 1
                    rojo = (rojo + div(b1, 16) % 4 + 254) % 256
                    verde = (verde + div(b1, 4) % 4 + 254) % 256
                    azul = (azul + b1 % 4 + 254) % 256
                    i = i + 1
                else if tipo == 2
                    if i + 1 >= fin
                        return 6
                    let b2 = director.byte(i + 1)
                    let dv = b1 % 64
                    # dv - 32 en verde; y en rojo y azul, dv - 32 + (d - 8).
                    rojo = (rojo + dv + div(b2, 16) + 216) % 256
                    verde = (verde + dv + 224) % 256
                    azul = (azul + dv + b2 % 16 + 216) % 256
                    i = i + 2
                else
                    tanda = b1 % 64
                    i = i + 1
            let celda = ((rojo * 3 + verde * 5 + azul * 7 + alfa * 11) % 64) * 4
            tabla[celda] = rojo
            tabla[celda + 1] = verde
            tabla[celda + 2] = azul
            tabla[celda + 3] = alfa
        push(mut px, azul)
        push(mut px, verde)
        push(mut px, rojo)
        push(mut px, alfa)
    medidas[0] = ancho
    medidas[1] = alto
    return 0

# ===================================================================
#  La salida: SOLO con la imagen entera ya contada
# ===================================================================

fn pon16(v: int)
    director.escribe(v % 256)
    director.escribe(div(v, 256))

fn guarda_bico(ruta: text, px: [int], medidas: [int; 2]) -> int
    if not director.crea(ruta)
        return 7
    director.escribe(66)
    director.escribe(73)
    director.escribe(67)
    director.escribe(79)
    pon16(medidas[0])
    pon16(medidas[1])
    for b in px
        director.escribe(b)
    if not director.cierra()
        return 8
    return 0

fn convierte(entrada: text, salida: text, es_qoi: bool) -> int
    if not director.fichero(entrada)
        return 1
    let mut px: [int] = []
    let mut medidas: [int; 2] = [0, 0]
    let mut e = 0
    if es_qoi
        e = qoi_a_bico(mut px, mut medidas)
    else
        e = bmp_a_bico(mut px, mut medidas)
    if e == 0
        e = guarda_bico(salida, px, medidas)
    return e

fn main()
    print("-- bico")
    print("bmp ", convierte("datos/foto.bmp", "datos/fotob.bic", false))
    print("qoi ", convierte("datos/foto.qoi", "datos/fotoq.bic", true))
    print("fin")
