# Camara nativa: posicion y orientacion como componentes, sin jerarquias.
mod camera "camara de MUNDO con giro e inclinacion"

pub type Position
    x: int
    y: int
    z: int

pub type Angles
    yaw: int
    pitch: int

pub type Camera
    position: Position
    angles: Angles

pub fn initial() -> Camera
    return Camera { position: Position { x: 80000, y: 36000, z: 15000 }, angles: Angles { yaw: 0, pitch: 0 } }

# O1: el llamador presta solo el componente de orientacion.
pub fn turn(mut angles: Angles, yaw: int, pitch: int)
    rotate(mut angles, yaw * 150, pitch * 150)

# Decimas de grado: teclado y raton comparten los mismos limites.
pub fn rotate(mut angles: Angles, yaw: int, pitch: int)
    angles.yaw = rem(angles.yaw + yaw, 3600)
    angles.pitch = angles.pitch + pitch
    if angles.pitch > 750
        angles.pitch = 750
    if angles.pitch < -750
        angles.pitch = -750

pub fn sine(k: int) -> int
    let t: [int; 24] = [0, 259, 500, 707, 866, 966, 1000, 966, 866, 707, 500, 259, 0, -259, -500, -707, -866, -966, -1000, -966, -866, -707, -500, -259]
    let angle = rem(k, 3600)
    let fraction = rem(angle, 150)
    let step = div(angle, 150)
    let delta = (t[(step + 1) % 24] - t[step]) * fraction
    # hacia el cero, como antes, no `div`: `delta` puede ser negativo, y el
    # piso moveria la tabla una milesima donde el seno baja
    return t[step] + (delta - delta % 150) / 150

pub fn cosine(k: int) -> int
    return sine(k + 900)

pub fn axis(cam: Camera, a: int) -> int
    if a == 0
        return cam.position.x
    if a == 1
        return cam.position.y
    return cam.position.z
