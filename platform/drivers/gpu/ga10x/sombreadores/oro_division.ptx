// oro_division.ptx -- el PTX de las PALABRAS DE ORO de E6d (`ORO_E6D` en
// bmo-sm86/src/codifica.rs): la division y el resto de enteros.
// Rehacerlas (CUDA 12.9 y nvdisasm 13.4, de PyPI, 02-10):
//   ptxas -arch=sm_86 -O3 oro_division.ptx -o oro.cubin
//   nvdisasm -hex oro.cubin
// `div_u32`, `rem_u32`, `div_s32`, `rem_s32`: el reciproco del divisor
// (I2F.RP, MUFU.RCP, F2I.FTZ), una vuelta de Newton con IMAD.HI.U32 y dos
// correcciones; con signo, sobre los IABS. `mulhi` (E6d, la division por
// una constante): IMAD.HI.U32 con un inmediato (la forma 4). `acarreo`:
// IADD3 con el acarreo a un predicado (`sub.cc`) e IADD3.X que lo suma
// (`addc`): las correcciones de la division en tres instrucciones.
.version 8.0
.target sm_86
.address_size 64
.visible .entry div_u32(.param .u64 pin, .param .u64 pout)
{
  .reg .s32 %r<10>;
  .reg .u64 %rd<4>;
  ld.param.u64 %rd1, [pin];
  ld.param.u64 %rd2, [pout];
  ld.global.s32 %r1, [%rd1];
  ld.global.s32 %r2, [%rd1+4];
  div.u32 %r3, %r1, %r2;
  st.global.s32 [%rd2], %r3;
  ret;
}
.visible .entry rem_u32(.param .u64 pin, .param .u64 pout)
{
  .reg .s32 %r<10>;
  .reg .u64 %rd<4>;
  ld.param.u64 %rd1, [pin];
  ld.param.u64 %rd2, [pout];
  ld.global.s32 %r1, [%rd1];
  ld.global.s32 %r2, [%rd1+4];
  rem.u32 %r3, %r1, %r2;
  st.global.s32 [%rd2], %r3;
  ret;
}
.visible .entry div_s32(.param .u64 pin, .param .u64 pout)
{
  .reg .s32 %r<10>;
  .reg .u64 %rd<4>;
  ld.param.u64 %rd1, [pin];
  ld.param.u64 %rd2, [pout];
  ld.global.s32 %r1, [%rd1];
  ld.global.s32 %r2, [%rd1+4];
  div.s32 %r3, %r1, %r2;
  st.global.s32 [%rd2], %r3;
  ret;
}
.visible .entry rem_s32(.param .u64 pin, .param .u64 pout)
{
  .reg .s32 %r<10>;
  .reg .u64 %rd<4>;
  ld.param.u64 %rd1, [pin];
  ld.param.u64 %rd2, [pout];
  ld.global.s32 %r1, [%rd1];
  ld.global.s32 %r2, [%rd1+4];
  rem.s32 %r3, %r1, %r2;
  st.global.s32 [%rd2], %r3;
  ret;
}
.visible .entry mulhi(.param .u64 pin, .param .u64 pout)
{
  .reg .s32 %r<20>;
  .reg .u64 %rd<4>;
  ld.param.u64 %rd1, [pin];
  ld.param.u64 %rd2, [pout];
  ld.global.s32 %r1, [%rd1];
  mul.hi.u32 %r2, %r1, 613566757;
  shr.u32 %r3, %r2, 2;
  st.global.s32 [%rd2], %r3;
  mul.hi.u32 %r4, %r1, -858993459;
  st.global.s32 [%rd2+4], %r4;
  ret;
}
.visible .entry acarreo(.param .u64 pin, .param .u64 pout)
{
  .reg .s32 %r<20>;
  .reg .u64 %rd<4>;
  ld.param.u64 %rd1, [pin];
  ld.param.u64 %rd2, [pout];
  ld.global.u32 %r1, [%rd1];
  ld.global.u32 %r2, [%rd1+4];
  ld.global.u32 %r3, [%rd1+8];
  sub.cc.u32 %r4, %r1, %r2;
  addc.u32 %r5, %r3, 0;
  st.global.u32 [%rd2], %r4;
  st.global.u32 [%rd2+4], %r5;
  add.cc.u32 %r6, %r1, %r3;
  addc.u32 %r7, %r2, %r3;
  st.global.u32 [%rd2+8], %r6;
  st.global.u32 [%rd2+12], %r7;
  ret;
}
