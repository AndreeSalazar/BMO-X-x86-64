// oro_ldc.ptx -- el PTX de las PALABRAS DE ORO del LDC con INDICE
// (`ORO_LDC` en src/codifica.rs; E8f de PLAN_LA_LENGUA_DE_LA_3060, DL18).
// Rehacerlas (CUDA 12.9 y nvdisasm 13.4.92, de PyPI):
//   pip download --no-deps "nvidia-cuda-nvcc-cu12==12.9.*"
//   pip download --no-deps "nvidia-cuda-nvdisasm==13.4.*"
//   ptxas -arch=sm_86 -O3 oro_ldc.ptx -o oro.cubin
//   nvdisasm -hex oro.cubin
// Un `.const` leido con la fila en un registro: `ptxas` lo pone en el banco
// 3 y lo lee con LDC, el indice en BYTES en Ra y el resto en el inmediato.
.version 8.0
.target sm_86
.address_size 64
.const .align 16 .b8 banco[4096];
.visible .entry ldc(.param .u64 o)
{
  .reg .b64 %rd<8>; .reg .b32 %r<8>; .reg .f32 %f<8>;
  ld.param.u64 %rd2, [o]; cvta.to.global.u64 %rd3, %rd2;
  ld.global.u32 %r1, [%rd3];
  shl.b32 %r2, %r1, 4;
  cvt.u64.u32 %rd4, %r2;
  mov.u64 %rd5, banco;
  add.s64 %rd6, %rd5, %rd4;
  ld.const.v4.f32 {%f1, %f2, %f3, %f4}, [%rd6+32];
  st.global.v4.f32 [%rd3+16], {%f1, %f2, %f3, %f4};
  ld.const.f32 %f5, [%rd6+4];
  st.global.f32 [%rd3+32], %f5;
  ret;
}
