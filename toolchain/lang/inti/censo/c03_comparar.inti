# sonda: c03_comparar         espera: E0077
# era `COMPILA` -- escrita en `pleno`, que se fue a TITAN++ el 2026-10-04 (PLAN_INTI_SAMURAI.md)
# fija: `=` compara en una expresion y asigna en una sentencia. Sin
# ambiguedad porque asignar NO es una expresion.
perfil pleno

funcion principal
    nombre = "eddi"
    si nombre = "eddi"
        escribe("eres tu")
    si nombre no es "ana"
        escribe("no eres ana")
    si 5 es un numero
        escribe("cinco es un numero")
