# sonda: c04_bucles           espera: E0077
# era `COMPILA` -- escrita en `pleno`, que se fue a TITAN++ el 2026-10-04 (PLAN_INTI_SAMURAI.md)
# fija: un solo bucle con tres formas, y el rango excluye el final.
perfil pleno

funcion principal
    para cada i en 0 hasta 3
        escribe(i)

    repite 2 veces
        escribe(".")

    cambiante quedan = cierto
    repite mientras quedan
        quedan = falso
