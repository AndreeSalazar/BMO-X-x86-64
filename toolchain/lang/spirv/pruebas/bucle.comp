#version 450
// bucle: no termina mientras bandera[0] sea 0. El oraculo tiene que parar por
// COMBUSTIBLE en vez de colgar al que lo llama.
layout(local_size_x = 1) in;
layout(std430, binding = 0) buffer Bandera { uint bandera[]; };
void main() {
    uint n = 0u;
    while (bandera[0] == 0u) { n++; }
    bandera[1] = n;
}
