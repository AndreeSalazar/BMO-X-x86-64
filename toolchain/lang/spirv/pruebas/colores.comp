#version 450
// colores: de un valor a un color empaquetado. OpSelect, OpPhi, vectores, GLSL.std.450.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Valores { float v[]; };
layout(std430, binding = 1) writeonly buffer Colores { uint rgba[]; };
uint canal(float x) { return uint(clamp(x, 0.0, 1.0) * 255.0 + 0.5); }
void main() {
    uint i = gl_GlobalInvocationID.x;
    float t = fract(abs(v[i]));
    vec3 col = t < 0.5 ? mix(vec3(0.0, 0.0, 1.0), vec3(0.0, 1.0, 0.0), t * 2.0)
                       : mix(vec3(0.0, 1.0, 0.0), vec3(1.0, 0.0, 0.0), t * 2.0 - 1.0);
    uint a = v[i] < 0.0 ? 128u : 255u;
    rgba[i] = canal(col.r) | (canal(col.g) << 8) | (canal(col.b) << 16) | (a << 24);
}
