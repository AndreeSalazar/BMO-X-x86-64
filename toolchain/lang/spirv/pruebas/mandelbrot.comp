#version 450
// mandelbrot: un pixel por invocacion. Bucle con salida temprana, flotantes y enteros.
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) writeonly buffer Salida { uint vueltas[]; };
layout(std140, binding = 1) uniform Ventana { vec2 origen; vec2 paso; uint ancho; uint tope; };
void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    vec2 c = origen + vec2(p) * paso;
    vec2 z = vec2(0.0);
    uint k = 0u;
    while (k < tope && dot(z, z) <= 4.0) {
        z = vec2(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + c;
        k++;
    }
    vueltas[p.y * ancho + p.x] = k;
}
