#version 450
// trig: las cinco trascendentes de S3b en un sombreador. El oraculo las
// ejecuta con `math`, la MISMA definicion que usara el emisor.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer V { float v[]; };
layout(std430, binding = 1) writeonly buffer S { float s[]; };
layout(std430, binding = 2) writeonly buffer C { float c[]; };
layout(std430, binding = 3) writeonly buffer E { float e[]; };
layout(std430, binding = 4) writeonly buffer L { float l[]; };
layout(std430, binding = 5) writeonly buffer P { float p[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    float x = v[i];
    s[i] = sin(x);
    c[i] = cos(x);
    e[i] = exp(x * 0.1);
    l[i] = log(abs(x) + 1.0);
    p[i] = pow(abs(x) + 1.0, 1.5);
}
