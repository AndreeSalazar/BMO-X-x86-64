# LA MEDIDA GUARDADA, leida de lo tenido: `datos/resol.txt` dice
# "ANCHO ALTO" (y un salto de linea), lo que escribe RESOLUCION al pulsar
# Enter. 0 si no se entiende: hasta cinco cifras, un espacio entre las dos
# y nada detras. Una ventana de TITAN++ que quiera la medida elegida la lee
# asi: ECCE, RESOLUCION y TINTA la llevaban copiada, ahora la piden.
mod medida "la medida que eligio RESOLUCION: ANCHO ALTO en datos/resol.txt"
use director
use casa.cifras

# Cuantas cifras seguidas hay desde `desde` (hasta seis: la sexta ya sobra).
fn cifras_desde(desde: int) -> int
    let mut n = 0
    while n < 6 and cifras.es_cifra(director.byte(desde + n))
        n = n + 1
    return n

# El numero de `n` cifras que empieza en `desde`.
fn numero(desde: int, n: int) -> int
    let mut v = 0
    for k in range(n)
        v = v * 10 + cifras.valor(director.byte(desde + k))
    return v

pub fn ancho() -> int
    let n = cifras_desde(0)
    if n == 0 or n > 5 or director.byte(n) != 32
        return 0
    return numero(0, n)

pub fn alto() -> int
    let desde = cifras_desde(0) + 1
    let n = cifras_desde(desde)
    let fin = director.byte(desde + n)
    if n == 0 or n > 5 or not (fin == -1 or fin == 10 or fin == 13)
        return 0
    return numero(desde, n)
