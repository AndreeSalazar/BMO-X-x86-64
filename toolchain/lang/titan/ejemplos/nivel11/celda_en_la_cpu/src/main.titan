# espera: T0090
# `celda()` dice que celda cuenta un hilo de la GPU (LB9): una fn de la CPU
# no es un hilo de nadie
mod main "la celda de quien"

gpu fn suaviza(x: f32, campo: [f32]) -> f32
    let i = celda()
    return (campo[i - 1.0] + x + campo[i + 1.0]) * 0.25

fn main()
    let i = celda()
    print(round(i, 2))
