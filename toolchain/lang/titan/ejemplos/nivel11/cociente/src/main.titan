# espera: BIEN
# sale: 1 / 3 = 0.333333
# sale: 10 / 4 = 2.500000
# sale: 1 / 7 = 0.142857
# sale: 7 / 7 = 1.000000
# sale: un tercio de un tercio de un tercio de 27: 1.000000
# la division GENERAL en la 3060, EXACTA (DL10): entre cualquier numero, no solo entre una potencia de dos, los mismos bits que la CPU y el calculo -- y en la obra de la celda pesa su cuenta, 24
mod main "la 3060 divide exacta"

gpu fn cociente(a: f32, b: f32) -> f32
    return a / b

gpu fn tercios(x: f32) -> f32
    let mut r = x
    for i in range(3)
        r = r / 3.0
    return r

fn main()
    let xs: [f32; 4] = [1.0, 10.0, 1.0, 7.0]
    let ys: [f32; 4] = [3.0, 4.0, 7.0, 7.0]
    let c = cociente(xs, ys)
    print("1 / 3 = ", round(c[0], 6))
    print("10 / 4 = ", round(c[1], 6))
    print("1 / 7 = ", round(c[2], 6))
    print("7 / 7 = ", round(c[3], 6))
    let zs: [f32; 1] = [27.0]
    let t = tercios(zs)
    print("un tercio de un tercio de un tercio de 27: ", round(t[0], 6))
