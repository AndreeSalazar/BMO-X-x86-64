mod num "las cuentas de bmo_cubo, en f32: + - * / y comparaciones, en su orden"

# Las de `bmo_cubo::num` (platform/shared/bmo-cubo/src/num.rs), una a una y en
# el MISMO orden: por eso dan sus mismos bits. Lo que alli se hace con los
# bits de un f32 (`to_bits`, `as i64`) aqui se cuenta con f32 EXACTOS: sumar
# 2^23 a un numero de [0, 2^23) lo redondea a entero sin perder nada, y
# multiplicar por una potencia de dos no redondea.

# `(v as i64) as f32` para v >= 0, o NaN (que da 0): truncar hacia el cero.
pub gpu fn trunca(v: f32) -> f32
    # i64 se satura en 2^63 - 1, que en f32 es 2^63.
    if v >= 9223372036854775807
        return 9223372036854775807
    # Desde 2^23 todo f32 ya es entero.
    if v >= 8388608.0
        return v
    if v >= 0.0
        let t = (v + 8388608.0) - 8388608.0
        if t > v
            return t - 1.0
        return t
    return 0.0

# `redondear`: el entero mas cercano, mitades hacia fuera del cero.
pub gpu fn redondear(x: f32) -> f32
    if x >= 0.0
        return trunca(x + 0.5)
    let t = trunca(-x + 0.5)
    # `-(0 as i64)` es 0, y el 0 de un i64 es +0.0.
    if t == 0.0
        return 0.0
    return -t

# Si un entero de f32 es impar.
gpu fn impar(n: f32) -> bool
    let medio = n * 0.5
    return trunca(medio) != medio and trunca(-medio) != -medio

# `redondear_par`: el entero mas cercano, empates al PAR -- lo que hace la GPU
# al pasar una posicion a punto fijo.
pub gpu fn redondear_par(x: f32) -> f32
    let mut t = trunca(x)
    if x < 0.0
        t = -trunca(-x)
    let mut piso = t
    if t > x
        piso = t - 1.0
    let resto = x - piso
    if resto > 0.5
        return piso + 1.0
    if resto == 0.5 and impar(piso)
        return piso + 1.0
    return piso

# `clamp(0, 1)`: un NaN sigue siendo NaN.
pub gpu fn saturar(x: f32) -> f32
    if x < 0.0
        return 0.0
    if x > 1.0
        return 1.0
    return x

# `x` a [-pi, pi], con 2 pi partido en dos (Cody-Waite).
pub gpu fn reducir(x: f32) -> f32
    let dos_pi = 6.2831855
    let bajo = -0.00000017484555
    let k = redondear(x / dos_pi)
    return (x - k * dos_pi) - k * bajo

# El seno, con su polinomio de Taylor de grado 11 en [-pi/2, pi/2].
pub gpu fn seno(x: f32) -> f32
    let pi = 3.1415927
    let medio_pi = 1.5707964
    let mut r = reducir(x)
    if r > medio_pi
        r = pi - r
    else
        if r < -medio_pi
            r = -pi - r
    let r2 = r * r
    return r * (1.0 + r2 * (-1.0 / 6.0 + r2 * (1.0 / 120.0 + r2 * (-1.0 / 5040.0 + r2 * (1.0 / 362880.0 + r2 * (-1.0 / 39916800.0))))))

# El coseno, con su polinomio de grado 12. Su `abs` borra el signo, tambien
# el de -0: 0 - r da +0.
pub gpu fn coseno(x: f32) -> f32
    let pi = 3.1415927
    let medio_pi = 1.5707964
    let mut r = reducir(x)
    if r <= 0.0
        r = 0.0 - r
    let mut signo = 1.0
    if r > medio_pi
        r = pi - r
        signo = -1.0
    let r2 = r * r
    return signo * (1.0 + r2 * (-0.5 + r2 * (1.0 / 24.0 + r2 * (-1.0 / 720.0 + r2 * (1.0 / 40320.0 + r2 * (-1.0 / 3628800.0 + r2 * (1.0 / 479001600.0)))))))

pub gpu fn tangente(x: f32) -> f32
    return seno(x) / coseno(x)

# El suelo de un f32 de [0, 2^23): el entero de debajo.
gpu fn suelo(v: f32) -> f32
    let t = (v + 8388608.0) - 8388608.0
    if t > v
        return t - 1.0
    return t

# 2^e para un entero e de [-127, 127], potencia a potencia: exacto.
gpu fn dos_a_la(e: f32) -> f32
    let p32 = 4294967296.0
    let mut n = e
    if n < 0.0
        n = -n
    let mut p = 1.0
    if n >= 64.0
        p = p * p32 * p32
        n = n - 64.0
    if n >= 32.0
        p = p * p32
        n = n - 32.0
    if n >= 16.0
        p = p * 65536.0
        n = n - 16.0
    if n >= 8.0
        p = p * 256.0
        n = n - 8.0
    if n >= 4.0
        p = p * 16.0
        n = n - 4.0
    if n >= 2.0
        p = p * 4.0
        n = n - 2.0
    if n >= 1.0
        p = p * 2.0
    if e < 0.0
        return 1.0 / p
    return p

# ** LA ESTIMACION de `raiz`: `f32::from_bits((x.to_bits() >> 1) + 0x1FBD1DF5)`
# para 0 < x < infinito, con los bits contados en f32 exactos. El f32 es
# E 2^23 + M (E, el campo de exponente; M, la mantisa); su mitad por abajo,
# (E >> 1) 2^23 + (E & 1) 2^22 + (M >> 1); y 0x1FBD1DF5 = 63 2^23 + 4005365.
gpu fn estimacion(x: f32) -> f32
    let p32 = 4294967296.0
    let p64 = p32 * p32
    let q16 = 0.0000152587890625
    let q32 = q16 * q16
    let q64 = q32 * q32
    let mut e = 0.0
    let mut m = 0.0
    if x * p64 * p64 < 4.0
        # subnormal (x < 2^-126): E = 0 y M = x 2^149
        m = x * p64 * p64 * 2097152.0
    else
        # x = y 2^(E - 127) con y en [1, 2): una potencia de dos cada vez
        let mut y = x
        e = 127.0
        if y >= 2.0
            if y * q64 >= 1.0
                y = y * q64
                e = e + 64.0
            if y * q32 >= 1.0
                y = y * q32
                e = e + 32.0
            if y * q16 >= 1.0
                y = y * q16
                e = e + 16.0
            if y * 0.00390625 >= 1.0
                y = y * 0.00390625
                e = e + 8.0
            if y * 0.0625 >= 1.0
                y = y * 0.0625
                e = e + 4.0
            if y * 0.25 >= 1.0
                y = y * 0.25
                e = e + 2.0
            if y * 0.5 >= 1.0
                y = y * 0.5
                e = e + 1.0
        if y < 1.0
            if y * p64 < 2.0
                y = y * p64
                e = e - 64.0
            if y * p32 < 2.0
                y = y * p32
                e = e - 32.0
            if y * 65536.0 < 2.0
                y = y * 65536.0
                e = e - 16.0
            if y * 256.0 < 2.0
                y = y * 256.0
                e = e - 8.0
            if y * 16.0 < 2.0
                y = y * 16.0
                e = e - 4.0
            if y * 4.0 < 2.0
                y = y * 4.0
                e = e - 2.0
            if y * 2.0 < 2.0
                y = y * 2.0
                e = e - 1.0
        m = (y - 1.0) * 8388608.0
    let h = suelo(e * 0.5)
    let mut l = (e - 2.0 * h) * 4194304.0 + suelo(m * 0.5) + 4005365.0
    let mut nuevo = h + 63.0
    if l >= 8388608.0
        l = l - 8388608.0
        nuevo = nuevo + 1.0
    # el f32 de esos bits: (1 + L 2^-23) 2^(E' - 127)
    return (1.0 + l / 8388608.0) * dos_a_la(nuevo - 127.0)

# La raiz: la estimacion por bits y cuatro pasos de Newton. Con un NaN o un
# infinito, la de bmo_cubo acaba en NaN.
pub gpu fn raiz(x: f32) -> f32
    if x <= 0.0
        if x == 0.0
            return 0.0
        return 0.0 / 0.0
    if x - x != 0.0
        return 0.0 / 0.0
    let mut y = estimacion(x)
    for i in range(4)
        y = 0.5 * (y + x / y)
    return y
