# sale: ##...
# sale: el mundo tiene 7 bloques; agua: 4
# un mundo de cubos en chico: cada bloque, por su SITIO -- un mapa cuya clave es un registro
mod main "un mundo de bloques"

type Sitio
    x: int
    y: int

fn pinta(mundo: {Sitio: text}, alto: int, ancho: int)
    for y in range(alto)
        let mut fila = ""
        for x in range(ancho)
            match get(mundo, Sitio { x: x, y: y })
                Hay(b)
                    fila = fila + b
                NoHay
                    fila = fila + "."
        print(fila)

fn main()
    let mut mundo: {Sitio: text} = {}
    for x in range(2)
        put(mut mundo, Sitio { x: x, y: 2 }, "#")
    put(mut mundo, Sitio { x: 1, y: 1 }, "#")
    for y in range(2)
        for x in range(2, 4)
            put(mut mundo, Sitio { x: x, y: y }, "~")
    pinta(mundo, 3, 5)
    let mut agua = 0
    for s in mundo
        match get(mundo, s)
            Hay(b)
                if b == "~"
                    agua = agua + 1
            NoHay
                print("?")
    print("el mundo tiene ", len(mundo), " bloques; agua: ", agua)
