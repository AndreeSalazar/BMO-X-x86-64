<!--
   LOS VIDEOS -- la primera REJILLA de datos (H6, 04-10): `video.maqueta`
   hasta 4 veces, en 2 columnas, `entre` 16 px en los dos sentidos. Se
   maqueta y se juzga con las cuatro; en el codigo sale `LISTA_VIDEOS`, y
   `fila(i)` dice donde va cada una.
-->
<maqueta>
  <style>
    .canal   { display:flex; flex-direction:column; gap:12px; padding:16px;
               border-radius:14px; background-color:#0A0D14 }
    .rotulo  { font-size:11px; font-weight:500; letter-spacing:.14em;
               text-transform:uppercase; line-height:16px; color:#6E7A89 }
  </style>

  <div class="canal">
    <span class="rotulo">el canal</span>
    <usa id="videos" src="video.maqueta" repite="4" columnas="2" entre="16"/>
  </div>
</maqueta>
