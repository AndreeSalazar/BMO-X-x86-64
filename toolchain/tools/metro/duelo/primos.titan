# EL DUELO (PLAN_TITAN_AFINADO): contar los primos de 2 a 20000 por division: bucles, `%` y `break`.
# El MISMO programa que primos.c. El numero entra por la consola: si se
# escribiera, el calculo (E0) lo resolveria al compilar y no habria duelo.
# entra: 20000
mod main "el duelo: primos"

fn main()
    let mut n = 0
    match numero(lee())
        Es(x)
            n = x
        NoEs
            n = 0
    let mut c = 0
    for k in range(2, n)
        let mut p = 1
        let mut d = 2
        while d * d <= k
            if k % d == 0
                p = 0
                break
            d = d + 1
        c = c + p
    print(c)
